      "parameters": {
        "jsCode": "// Atrapamos la respuesta del agente\nconst outputAgente = $('Agente de analisis').item.json.output;\n\n// Atrapamos en qué \"vuelta\" del bucle estamos (0, 1, 2, 3...)\nconst runIndex = $('Agente de analisis').context.runIndex || 0;\n\nreturn {\n  execution_id: $execution.id,\n  run_index: runIndex,\n  ai_response: outputAgente,\n  environment: \"dev\" \n};"
