        "parameters": {
          "jsCode": "const items = $input.all();\n\n// Sort items by id\nitems.sort((a, b) => a?.json?.id - b?.json?.id);\n\n// Group items by session_id\nconst groupedItems = items.reduce((acc, item) => {\n  const sessionId = item?.json?.session_id;\n  if (!acc[sessionId]) {\n    acc[sessionId] = [];\n  }\n  acc[sessionId].push(item?.json?.message);\n  return acc;\n}, {});\n\n// Create result array\nconst result = Object.entries(groupedItems).map(([sessionId, messages]) => {\n  return {\n    json: {\n      session_id: sessionId,\n      messages: messages.join(\", \"),\n    },\n  };\n});\n\nreturn result;\n"
        },
