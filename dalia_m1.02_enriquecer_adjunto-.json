          "mode": "runOnceForAllItems",
          "jsCode": "// M1.02 · Prepara el enriquecimiento a partir del adjunto descargado (binario \"data\" que devuelve INT.port channel.get_media)\n// Salida: {plan, media, store, model_request, skipped} y el mismo binario (para subirlo a Storage).\nconst plan = $('Plan de enriquecimiento').first().json.p;\nconst item = $input.first();\nconst res = item.json || {};\nconst bin = item.binary && item.binary.data;\nif (!res.ok || !bin) {\n  return [{ json: { plan, media: { ok: false, error: (res.error && (res.error.code || res.error.message)) || 'sin archivo' }, store: false, model_request: null } }];\n}\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst mime = (res.data && res.data.mime_type) || bin.mimeType || plan.mime_type || 'application/octet-stream';\nconst media = { ok: true, bytes: buf.length, mime_type: mime };\nlet model_request = null, skipped = null;\nif (plan.kind === 'transcribe' || plan.kind === 'describe') {\n  if (buf.length > plan.max_bytes) {\n    skipped = 'too_large';\n  } else if (plan.kind === 'transcribe') {\n    const ext = (mime.split('/')[1] || 'ogg').split(';')[0].trim() || 'ogg';\n    model_request = { port: 'llm', operation: 'transcribe', envelope: plan.envelope || {},\n      input: { audio_base64: buf.toString('base64'), mime_type: mime.split(';')[0], filename: 'audio.' + ext,\n               language: plan.transcribe.language, model: plan.transcribe.model || undefined } };\n  } else {\n    model_request = { port: 'llm', operation: 'complete', envelope: plan.envelope || {},\n      input: { model: plan.describe.model || undefined, max_output_tokens: plan.describe.max_output_tokens,\n               messages: [ { role: 'user', content: [\n                 { type: 'text', text: plan.describe.prompt + (plan.caption ? '\\nLeyenda del cliente: ' + plan.caption : '') },\n                 { type: 'image_url', image_url: { url: 'data:' + mime.split(';')[0] + ';base64,' + buf.toString('base64') } } ] } ] } };\n  }\n}\nreturn [{ json: { plan, media, store: plan.store === true && !!(plan.storage && plan.storage.url), model_request, skipped }, binary: item.binary }];"
        }
      },
