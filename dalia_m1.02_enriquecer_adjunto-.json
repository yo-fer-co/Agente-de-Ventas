    {
      "id": "57efaf12-2f2f-4660-970c-e7fdde01bc48",
      "name": "Resultado del enriquecimiento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// M1.02 · Reúne el resultado (descarga, Storage y modelo) para m1_set_enrichment\nconst prep = $('Preparar enriquecimiento').first().json;\nconst out = { kind: prep.plan.kind, media: prep.media, storage: null, model: null };\nif ($('Subir a Storage').isExecuted) {\n  const s = $('Subir a Storage').first().json;\n  const ok = !!s && s.statusCode >= 200 && s.statusCode < 300;\n  out.storage = { ok, path: prep.plan.storage.path, error: ok ? null : ('HTTP_' + (s && s.statusCode) + ' ' + JSON.stringify((s && s.body) || s.error || '').slice(0, 150)) };\n}\nif (prep.skipped) out.model = { skipped: prep.skipped };\nif ($('Transcribir o describir (INT.port)').isExecuted) {\n  const r = $('Transcribir o describir (INT.port)').first().json;\n  const text = r.ok ? (prep.plan.kind === 'transcribe' ? r.data && r.data.text : r.data && r.data.content) : null;\n  out.model = { status: r.status, text: text || null, model: r.data && r.data.model, cost_usd: r.cost_usd ?? null,\n                error: r.error ? (r.error.code || r.error.message) : null };\n}\nreturn [{ json: { message_id: prep.plan.message_id, result: out } }];"
      }
    },
