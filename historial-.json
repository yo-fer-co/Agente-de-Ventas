    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst groupedMessages = items.reduce((acc, item) => {\n  const id = item?.json?.id;\n  const message = `${item?.json?.rol}: ${item?.json?.mensaje}`;\n  const timestamp = item?.json?.timestamp;\n\n  if (!acc[id]) {\n    acc[id] = {\n      session_id: id,\n      messages: message,\n      timestamp: timestamp,\n    };\n  } else {\n    acc[id].messages += message;\n  }\n\n  return acc;\n}, {});\n\nreturn Object.values(groupedMessages);\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
