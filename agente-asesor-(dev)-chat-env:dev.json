      "id": "dc287c9d-6dc8-492a-a42f-0bea8732a880",
      "name": "Obtiene productos por  categoria"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.first().json.result.points\nconst categorias = items.reduce((acc, item) => {\n  const rawCategory = item.payload?.metadata?.categoria?.trim();\n\n  if (rawCategory) {\n    const pascalCased = rawCategory\n      .toLowerCase()\n      .split(' ')\n      .filter(word => word.length > 0)\n      .map(word => \n        word.charAt(0).toUpperCase() + word.slice(1)\n      )\n      .join('');\n\n    if (!acc.includes(pascalCased)) {\n      acc.push(pascalCased);\n    }\n  }\n  \n  return acc;\n}, []);\n\nreturn { items: categorias, tipo: \"Categoria\" };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        224
      ],
      "id": "3e96f4e4-788b-4e8b-9ff1-456531e13151",
      "name": "Agrupa categorias"
    },
    {
      "parameters": {
        "jsCode": "const items = $('Obtiene productos por  categoria').first().json.result.points\nconst productos = items.reduce((acc, item) => {\n const product = item.payload?.metadata?.titulo?.trim();\n if (product && !acc.includes(product)) {\n    acc.push(product);\n  }\n  \n  return acc;\n}, []);\n\nreturn productos.map((item) => {return {nombre: item}})\n\n"
      },
