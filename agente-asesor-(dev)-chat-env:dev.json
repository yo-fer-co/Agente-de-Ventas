        "jsonBody": "={\n  \"filter\": {\n    \"must\": [\n      {\n        \"key\": \"metadata.titulo\",\n        \"match\": {\n          \"text\": \"{{ $('Valida consulta catalogo').item.json.output.valor.toUpperCase() }}\"\n        }\n      }\n    ]\n  },\n  \"limit\": 30,\n  \"with_payload\": true\n}",
