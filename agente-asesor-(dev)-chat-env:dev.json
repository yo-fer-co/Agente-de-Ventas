    {
      "parameters": {
        "method": "POST",
        "url": "https://1537c683-48da-4631-ab76-ad698b6b9881.us-east-1-0.aws.cloud.qdrant.io/collections/BabysWorld_Catalogo/points/scroll",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIn0.JAQWQxC9pi-OqDGt1gflxPim1XwBWw6Iq7Nq8Xdan3s"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filter\": {\n    \"must\": [\n      {\n        \"key\": \"metadata.categoria\",\n        \"match\": {\n          \"value\": \"{{ $('Valida consulta catalogo').item.json.output.valor.toUpperCase() }}\"\n        }\n      }\n    ]\n  },\n  \"limit\": 30,\n  \"with_payload\": true\n}",
