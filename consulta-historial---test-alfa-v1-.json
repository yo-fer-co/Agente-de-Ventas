  "nodes": [
    {
      "parameters": {
        "content": "## Consulta historial - TEST Alfa V1\n\n1. Consulta historial de cliente en instancia QDrant, \"YoEco_Clientes_TEST\"",
        "height": 180,
        "width": 500,
        "color": 6
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -500,
        -340
      ],
      "typeVersion": 1,
      "id": "aa3a38d7-1cf3-47ad-bbb1-c732dc70168b",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f9ef56eb-0476-4526-b90a-f5babc081aa2",
              "name": "user_id",
              "value": "={{ $json.user_id }}",
              "type": "string"
            },
            {
              "id": "7ef0a44a-bbd8-47a5-8a11-5fd95ea502de",
              "name": "message",
              "value": "={{ $json.message }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "id": "5bfc1743-3798-40ab-b476-7fc1fb57ac7b",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"input\": \"{{$json[\"message\"]}}\",\n  \"model\": \"text-embedding-ada-002\"\n}\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ],
      "id": "d8c70240-b7e9-4bfd-b91b-db4b48409710",
      "name": "Embedding inicial",
      "credentials": {
        "openAiApi": {
          "id": "CxN1M3GiHPXWR4gx",
          "name": "OpenAi TEST"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    user_id: $('Edit Fields').first().json.user_id,\n    message: $('Edit Fields').first().json.message,\n    embedding: $input.first().json.data[0].embedding\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        0
      ],
      "id": "5201887b-4dcb-46fb-b503-b746841c65b2",
      "name": "Set parametros"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://1537c683-48da-4631-ab76-ad698b6b9881.us-east-1-0.aws.cloud.qdrant.io/collections/YoEco_Clientes_TEST/points/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "qdrantApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"vector\": {{ JSON.stringify($json.embedding) }},\n  \"top\": 3,\n  \"with_payload\": true,\n  \"filter\": {\n    \"must\": [\n      {\n        \"key\": \"user_id\",\n        \"match\": {\n          \"value\": {{ JSON.stringify($json.user_id) }}\n        }\n      }\n    ]\n  }\n}\n\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        0
      ],
      "id": "562e8a6d-8c59-4629-a343-20bee4d6737c",
      "name": "Consulta Qdrant",
      "credentials": {
        "qdrantApi": {
          "id": "9oUogOvtDqsTDKBQ",
          "name": "QdrantApi TEST"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const historial = $input.first().json.result || [];\nconst textos = historial.map(i => i.payload?.text || \"\").filter(Boolean).join(\"\\n---\\n\");\nconst user_id = $('Edit Fields').first().json.user_id;\nconst mensajeActual = $('Edit Fields').first().json.message;\n\nlet prompt = \"\";\n\nif (historial.length > 0) {\n  prompt = `Historial de usuario:\\n${textos}\\n\\nMensaje actual:\\n${mensajeActual}`;\n} else {\n  prompt = `Mensaje de nuevo usuario:\\n${mensajeActual}`;\n}\n\nreturn [{\n  json: {\n    user_id,\n    prompt,\n    historial_disponible: historial.length > 0\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        0
      ],
      "id": "e9b7753a-f29a-4c09-bf84-b6a9f9ecc42b",
      "name": "Agrega historial a prompt"
    },
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "user_id"
            },
            {
              "name": "message"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "id": "da090b4e-fb10-444a-9450-bcf86ed91d30",
      "name": "When Executed by Another Workflow"
    },
    {
