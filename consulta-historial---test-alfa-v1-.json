              "value": "={{ $json.user_id }}",
              "type": "string"
            },
            {
              "id": "6e4aed49-b622-4ac5-bb7d-22bfd5007352",
              "name": "prompt",
              "value": "={{ $json.prompt }}",
              "type": "string"
            },
            {
              "id": "5a71bd91-e971-4545-81fb-15765f3809fd",
              "name": "historial_disponible",
              "value": "={{ $json.historial_disponible }}",
              "type": "boolean"
