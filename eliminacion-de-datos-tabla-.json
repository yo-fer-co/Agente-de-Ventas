    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\n\nconst results = [];\nfor (let i = 0; i < items.length; i++) {\n  let item = items[i];\n\n  const updatedAt = new Date(item.json.updatedAt);\n  \n  // Calculamos la diferencia en milisegundos\n  const diff = now - updatedAt;\n\n  // Definimos el intervalo de 24 horas (24 * 60 min * 60 seg * 1000 ms)\n  const twelveHours = 24 * 60 * 60 * 1000;\n\n  // Si la diferencia es mayor a 12 horas, marcar para borrar\n  item.json.borrar = diff > twelveHours;\n  \n  results.push(item);\n}\n\nreturn results;"
      },
