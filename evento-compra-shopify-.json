    {
      "parameters": {
        "jsCode": "// 1. Función para limpiar el texto de caracteres invisibles\nfunction limpiarTexto(texto) {\n    if (typeof texto !== 'string') return texto;\n    \n    // Elimina caracteres invisibles (Zero-width, Word joiners, etc.)\n    let limpio = texto.replace(/[\\u200B-\\u200D\\uFEFF\\u2060\\u200E\\u200F]/g, ' ');\n    \n    // Reemplaza múltiples espacios en blanco seguidos por un solo espacio\n    limpio = limpio.replace(/\\s+/g, ' ').trim();\n    \n    return limpio;\n}\n\n// 2. Función recursiva para recorrer todo el JSON (listas y sub-objetos)\nfunction limpiarObjeto(obj) {\n    // Si es nulo o indefinido, lo dejamos igual\n    if (obj === null || obj === undefined) {\n        return obj;\n    }\n    \n    // Si es un texto, lo limpiamos\n    if (typeof obj === 'string') {\n        return limpiarTexto(obj);\n    }\n    \n    // Si es una lista (Array), limpiamos cada elemento por dentro\n    if (Array.isArray(obj)) {\n        return obj.map(item => limpiarObjeto(item));\n    }\n    \n    // Si es un objeto (JSON), limpiamos cada una de sus llaves\n    if (typeof obj === 'object') {\n        const nuevoObjeto = {};\n        for (const key in obj) {\n            nuevoObjeto[key] = limpiarObjeto(obj[key]);\n        }\n        return nuevoObjeto;\n    }\n    \n    // Si es un número o booleano (true/false), se queda igual\n    return obj;\n}\n\n// 3. Aplicamos la limpieza a los datos que entran al nodo en n8n\nfor (let item of $input.all()) {\n  item.json = limpiarObjeto(item.json);\n}\n\n// 4. Retornamos los datos ya limpios para el siguiente nodo\nreturn $input.all();"
      },
