    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfunction generateUUID() {\n  // genera UUID manualmente\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    const r = Math.random() * 16 | 0;\n    const v = c === 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n}\n\nreturn [{\n  json: {\n    id: generateUUID(),\n    vector: $input.first().json.data,\n    Texto: $input.first().json.Texto,\n    Sku: $input.first().json.Sku,\n    Titulo: $input.first().json.Titulo,\n    Categoria: $input.first().json.Categoria,\n    Precio: $input.first().json.Precio,\n    Stock: $input.first().json.Stock,\n    DescripcionBreve:$('Loop Over Items').first().json['DescripcionBreve*'] ,\n    Color:$input.first().json.Color,\n    timestamp: $now\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
