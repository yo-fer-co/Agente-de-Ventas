    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Node: Mapear Items\nconst row = $('Get many rows').item.json;\nconst lineItems = JSON.parse(row.Productos || \"[]\");\n\nconst items = lineItems.map(li => ({\n  code: li.sku || String(li.variant_id || li.product_id || \"\"),\n  description: li.name || li.title || \"\",\n  quantity: li.quantity,\n  price: parseFloat(li.price),\n  discount: parseFloat(li.total_discount || 0)\n}));\n\nreturn { json: { items } };"
      },
      "id": "fbc7a611-5182-42b1-a4c8-3bd9c8282a3c",
      "name": "ArrayItems",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
        16
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Node: Mapear Documento (sin items)\nconst row = $('Get many rows').item.json;\n\nconst billing = JSON.parse(row.direccion || \"{}\");\nconst customer = JSON.parse(row.customer || \"{}\");\nconst contactEmail = row.email || \"\";\nconst phoneRaw = billing.phone || customer.phone || \"\";\nconst phoneDigits = phoneRaw.replace(/\\D/g, \"\");\n\n// Separar indicativo (asumiendo Colombia = 57) si el número ya lo incluye\nlet indicative = \"57\";\nlet phoneNumber = phoneDigits;\nif (phoneDigits.startsWith(\"57\") && phoneDigits.length > 10) {\n  phoneNumber = phoneDigits.slice(2);\n}\n\nconst firstName = billing.first_name || customer.first_name || \"\";\nconst lastName = billing.last_name || customer.last_name || \"\";\n\nconst payDate = (row.fecha_pago || row.timestamp || \"\").slice(0, 10);\nconst zip = billing.zip || \"\";\n\nconst result = {\n  resultado:{\n  document: {\n    id: 2372\n  },\n  date: payDate,\n  customer: {\n    person_type: \"Person\",\n    id_type: \"13\",\n    identification: $('Code in JavaScript2').item.json.identification,\n    branch_office: 0,\n    name: [firstName, lastName].filter(Boolean),\n    address: {\n      address: [billing.address1, billing.address2].filter(Boolean).join(\" \"),\n      city: {\n        country_code: billing.country_code || \"COL\",\n        country_name: billing.country || \"Colombia\",\n        state_code: zip.slice(0,2) || \"\",\n        state_name: \"Bogotá, D.C.\",\n        city_code: zip.slice(0,2)+\"001\",\n        city_name: billing.city || \"\"\n      },\n      postal_code: zip\n    },\n    phones: [\n      {\n        indicative: indicative,\n        number: phoneNumber,\n        extension: \"\"\n      }\n    ],\n    contacts: [\n      {\n        first_name: firstName,\n        last_name: lastName,\n        email: contactEmail,\n        phone: {\n          indicative: indicative,\n          number: phoneNumber,\n          extension: \"\"\n        }\n      }\n    ]\n  },\n  seller: 926,\n  stamp: {\n    send: false\n  },\n  mail: {\n    send: true\n  },\n  items:$input.item.json.items,\n  payments: [\n    {\n      id: 8147,\n      value: parseFloat(row.Precio || 0),\n      due_date: payDate\n    }\n  ]\n},\n};\n\nreturn { json: result };"
      },
