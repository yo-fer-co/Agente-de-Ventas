    {
      "parameters": {
        "jsCode": "// Array donde guardaremos los nuevos ítems de n8n\nconst result = [];\n\n// Recorremos cada ítem de entrada\nfor (const item of $input.all()) {\n  // Verificamos si existe la propiedad 'items' y si es un array\n  if (item.json.items && Array.isArray(item.json.items)) {\n    for (const producto of item.json.items) {\n      result.push({\n        json: producto\n      });\n    }\n  }\n}\n\nreturn result;"
      },
