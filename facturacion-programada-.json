    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const wompiData = $('Consultar Wompi').first().json.data || [];\nconst body = $('Get many rows').first().json;\n\nconst orderTotalCents = Math.round(parseFloat( $('Get many rows').first().json.Precio || 0) * 100);\nconst orderDate = new Date(body.processed_at || body.created_at);\n\nconst candidatos = wompiData.filter(tx =>\n  tx.amount_in_cents === orderTotalCents &&\n  tx.status === \"APPROVED\"\n);\n\nconst match = candidatos.sort((a, b) =>\n  Math.abs(new Date(a.finalized_at) - orderDate) - Math.abs(new Date(b.finalized_at) - orderDate)\n)[0];\n\nconst idTypeMap = { CC: \"13\", NIT: \"31\", CE: \"22\", PP: \"41\" };\nconst legalId = match?.payment_method?.user_legal_id || \"\";\nconst legalIdType = match?.payment_method?.user_legal_id_type || \"CC\";\n\nconst identification = legalId || \"222222222222\";\nconst id_type = legalId ? (idTypeMap[legalIdType] || \"13\") : \"31\";\n\nreturn {\n  json: {\n    identification: identification,\n    id_type: id_type\n  }\n};"
      },
      "id": "d374350c-a73d-4f38-899c-e8ade4c5d0f7",
