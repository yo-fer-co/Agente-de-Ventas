      "id": "47c6c995-7255-4196-bf43-5c65b583bde0",
      "name": "Consultar Wompi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -672,
        16
      ],
