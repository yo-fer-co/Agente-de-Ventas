      "parameters": {
        "jsCode": "let items = $input.all();\nlet currentId = null;\n\n// Primera pasada: buscar el primer ID que aparezca para asignárselo a los mensajes iniciales (ej. fila 2)\nfor (let item of items) {\n  if (item.json['ID Caso']) {\n    currentId = item.json['ID Caso'];\n    break;\n  }\n}\n\n// Segunda pasada: rellenar hacia abajo\nfor (let item of items) {\n  if (item.json['ID Caso']) {\n    currentId = item.json['ID Caso']; // Actualiza el ID si encuentra uno nuevo\n  } else {\n    item.json['ID Caso'] = currentId; // Si está vacío, le pone el ID actual\n  }\n  \n  // Opcional: pre-formatear el texto para que sea más fácil de leer para la IA\n  item.json['Linea_Chat'] = item.json['agente'] + \": \" + item.json['mensaje'];\n}\n\nreturn items;"
      },
