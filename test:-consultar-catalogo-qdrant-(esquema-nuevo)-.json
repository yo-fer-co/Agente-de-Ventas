    {
      "parameters": {
        "jsCode": "// AJUSTADO (2026-09-08): copia literal de 'Agrupa productos' en 'Catalogo Qdrant (DEV)' --\n// lee item.payload.metadata.{titulo,categoria} (esquema viejo). NOTA: se omite deliberadamente\n// el paso de Google Drive ('Obtiene id categoria drive' / 'Datos categoria') que el flujo real\n// intercala aqui -- es una busqueda de carpeta por nombre de categoria, no afecta el resultado\n// de la busqueda en Qdrant ni requiere credenciales de Drive para validar el contrato de datos.\nconst items = $('Obtiene_Productos_Por_Categoria').first().json.result.points;\n\nconst group = items.reduce((acc, item) => {\n  const titulo = item.payload?.metadata?.titulo?.trim();\n  const categoria = item.payload?.metadata?.categoria?.trim() || \"Sin Categoría\";\n\n  if (titulo) {\n    if (!acc[categoria]) {\n      acc[categoria] = {\n        categoria: categoria,\n        productos: []\n      };\n    }\n\n    const isDuplicate = acc[categoria].productos.some(p => p.titulo === titulo);\n\n    if (!isDuplicate) {\n      acc[categoria].productos.push({ titulo });\n    }\n  }\n\n  return acc;\n}, {});\n\nreturn Object.values(group);\n"
      },
