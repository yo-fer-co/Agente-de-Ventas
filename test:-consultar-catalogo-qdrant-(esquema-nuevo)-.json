    {
      "parameters": {
        "jsCode": "// AJUSTADO (2026-09-08): copia literal de 'Agrupa categorias' en 'Catalogo Qdrant (DEV)' --\n// lee item.payload.metadata.categoria (esquema viejo), NO item.payload.collections.\n// Objetivo: simular exactamente lo que hace el flujo real hoy (sin modificarlo), para\n// validar si el espejo pageContent/metadata agregado en Product_Management (seccion 21\n// del plan, dual-write) alcanza para que 'Catalogo Qdrant (DEV)' funcione tal cual esta.\nconst items = $input.first().json.result.points\n\nconst categorias = items.reduce((acc, item) => {\n  const rawCategory = item.payload?.metadata?.categoria?.trim();\n\n  if (rawCategory) {\n    const pascalCased = rawCategory\n      .toLowerCase()\n      .split(' ')\n      .filter(word => word.length > 0)\n      .map(word => \n        word.charAt(0).toUpperCase() + word.slice(1)\n      )\n      .join('');\n\n    if (!acc.includes(pascalCased)) {\n      acc.push(pascalCased);\n    }\n  }\n  \n  return acc;\n}, []);\n\nreturn { items: categorias, tipo: \"Categoria\" };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
