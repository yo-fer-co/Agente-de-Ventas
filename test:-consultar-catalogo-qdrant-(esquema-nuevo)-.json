    {
      "parameters": {
        "jsCode": "// AJUSTADO (2026-09-08): copia literal de 'Agrupa productos1' en 'Catalogo Qdrant (DEV)' --\n// destructura directo de item.payload.metadata SIN guarda de null (igual que el flujo real).\n// Esto es intencional: si un punto no tiene 'metadata' (por ejemplo, uno viejo escrito antes\n// del dual-write de la seccion 21), este nodo va a fallar con un TypeError -- exactamente lo\n// mismo que le pasaria a 'Catalogo Qdrant (DEV)' hoy. Replicar el bug/comportamiento tal cual\n// es el punto de esta prueba: confirmar si el dual-write resuelve el problema de raiz.\nconst items = $input.first().json.result.points\n\nconst group = items.reduce((acc, item) => {\n const { titulo, categoria, precio, stock, descripcion, Color, sku } = item.payload?.metadata;\n  const colores = {\n    color : Color,\n    sku: sku\n  }\n\n  if (titulo) {\n    if (!acc[categoria]) {\n      acc[categoria] = {\n        categoria: categoria,\n        productos: []\n      };\n    }\n\n   const existingProduct = acc[categoria].productos.find(p => p.titulo === titulo);\n\n    if (!existingProduct) {\n      acc[categoria].productos.push({ \n        titulo : titulo,\n        colores: [colores],\n        precio: precio,\n        descripcion: descripcion,\n        stock: stock\n      });\n    } else {\n      existingProduct.colores.push(colores);\n    }\n  }\n\n  return acc;\n}, {});\n\nreturn Object.values(group);\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4208,
        816
      ],
      "id": "35c60730-dbc0-4a63-bdd1-1a10df6b1153",
      "name": "Agrupa_Productos1"
    },
    {
      "parameters": {
        "jsCode": "// AJUSTADO (2026-09-08): copia literal de 'sanetiza respuesta Qdrant' en 'Catalogo Qdrant (DEV)' --\n// 'search' devuelve result como array de puntos directamente (a diferencia de 'scroll', que usa\n// result.points), y destructura de item.payload.metadata SIN guarda de null, igual que el flujo real.\nconst items = $input.first().json.result\n\nconst group = items.reduce((acc, item) => {\n const { titulo, categoria, precio, stock, descripcion, Color, sku } = item.payload?.metadata;\n  const colores = {\n    color : Color,\n    sku: sku\n  }\n\n  if (titulo) {\n    if (!acc[categoria]) {\n      acc[categoria] = {\n        categoria: categoria,\n        productos: []\n      };\n    }\n\n     const existingProduct = acc[categoria].productos.find(p => p.titulo === titulo);\n\n    if (!existingProduct) {\n      acc[categoria].productos.push({ \n        titulo : titulo,\n        colores: [colores],\n        precio: precio,\n        descripcion: descripcion,\n        stock: stock\n      });\n    } else {\n      existingProduct.colores.push(colores);\n    }\n  }\n\n  return acc;\n}, {});\n\nreturn Object.values(group);\n"
      },
