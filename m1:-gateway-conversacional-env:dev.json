    {
      "parameters": {
        "jsCode": "const lookupResult = items[0]?.json || {};\nconst originalPayload = lookupResult.passthrough || {};\n\nconst sessionMemory = lookupResult.session_memory || {\n  found: false,\n  usable: false,\n  reason: 'memory_not_found'\n};\n\nconst softCustomerContext = lookupResult.soft_customer_context || {\n  has_relevant_memory: false,\n  memory_confidence: 'none',\n  safe_summary: null,\n  conversation_cues: [],\n  do_not_say: []\n};\n\nreturn [\n  {\n    json: {\n      ...originalPayload,\n      session_memory: sessionMemory,\n      soft_customer_context: softCustomerContext,\n      memory_lookup: {\n        performed: true,\n        found: Boolean(sessionMemory.found),\n        usable: Boolean(sessionMemory.usable),\n        reason: sessionMemory.reason || 'memory_not_found',\n        vector_memory_available: Boolean(softCustomerContext.has_relevant_memory)\n      }\n    }\n  }\n];\n"
