    {
      "parameters": {
        "jsCode": "function clean(value) {\n if (value === null || value === undefined) return '';\n return String(value).trim();\n}\n\nfunction makeEventId(prefix = 'evt') {\n return `${prefix}_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;\n}\n\nconst input = items[0]?.json || {};\n\nconst trace = input.trace || {};\nconst context = input.context || {};\nconst messageInput = input.input || input.message || {};\n\nconst text = clean(messageInput.text);\n\nconst event = {\n schema_version: 'dalia.m8.event_request.v1',\n event: {\n   event_id: makeEventId('evt_m1'),\n   event_name: 'message_received',\n   event_type: 'conversation',\n   module: 'M1',\n   status: 'success',\n   level: 'INFO',\n   timestamp: new Date().toISOString(),\n\n   trace: {\n     conversation_id: clean(trace.conversation_id),\n     session_id: clean(trace.session_id)\n   },\n\n   context: {\n     business_id: clean(context.business_id || 'business_demo'),\n     environment: clean(context.environment || 'demo'),\n     channel: clean(context.channel || messageInput.channel || 'whatsapp'),\n     user_id: clean(context.user_id || messageInput.from || messageInput.user_id),\n     display_name: clean(context.display_name)\n   },\n\n   correlation: {\n     message_id: clean(messageInput.message_id || messageInput.id)\n   },\n\n   payload: {\n     message_type: clean(messageInput.type || 'text'),\n     text_length: text.length,\n     processing_status: clean(messageInput.processing_status || 'ready'),\n     has_text: Boolean(text)\n   }\n }\n};\n\nreturn [\n {\n   json: {\n     ...input,\n     _main_payload_before_m8: input,\n     m8_event_request: event\n   }\n }\n];\n\n"
      },
