    {
      "parameters": {
        "jsCode": "function clean(value) {\n  if (value === null || value === undefined) return '';\n  return String(value).trim();\n}\n\nconst input = items[0]?.json || {};\n\nconst session = input.session || {};\nconst user = input.user || {};\nconst source = input.source || {};\nconst message = input.message || input.input || {};\n\nreturn [\n  {\n    json: {\n      schema_version: 'dalia.m4.memory_request.v1',\n      operation: 'get_turn_context',\n      lookup: {\n        session_id: clean(session.session_id || input.session_id),\n        conversation_id: clean(session.conversation_id || input.conversation_id),\n        user_id: clean(user.user_id || input.user_id),\n        channel: clean(source.channel || input.channel)\n      },\n      context: {\n        business_id: clean(input.business_id) || 'business_demo',\n        user_id: clean(user.user_id || input.user_id),\n        conversation_id: clean(session.conversation_id || input.conversation_id),\n        session_id: clean(session.session_id || input.session_id),\n        channel: clean(source.channel || input.channel)\n      },\n      current_turn: {\n        message_id: clean(message.message_id || message.id),\n        type: clean(message.type),\n        text: clean(message.text || message.normalized_text),\n        timestamp: clean(message.timestamp)\n      },\n      passthrough: input\n    }\n  }\n];"
      },
