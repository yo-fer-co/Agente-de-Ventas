    {
      "parameters": {
        "jsCode": "function clean(value) {\n  if (value === null || value === undefined) return '';\n  return String(value).trim();\n}\n\nfunction makeId(prefix) {\n  const ts = Date.now();\n  const rand = Math.random().toString(36).slice(2, 8);\n  return `${prefix}_${ts}_${rand}`;\n}\n\nconst input = items[0]?.json || {};\nconst rawInput = input.input || input.message || input.body || {};\n\nconst channel =\n  clean(input.context?.channel) ||\n  clean(rawInput.channel) ||\n  clean(input.channel) ||\n  'whatsapp';\n\n// 👇 Corrección 1: Buscamos el ID en la sesión y no le borramos las letras\nconst userId =\n  clean(input.session?.session_id) ||\n  clean(input.context?.user_id) ||\n  clean(input.user?.user_id);\n\nconst messageId =\n  clean(rawInput.message_id) ||\n  clean(rawInput.id) ||\n  clean(input.message_id) ||\n  makeId('msg');\n\nconst conversationId =\n  clean(input.session?.conversation_id) ||\n  clean(input.trace?.conversation_id) ||\n  `conv_${channel}_${userId}`;\n\nconst sessionId =\n  clean(input.session?.session_id) ||\n  clean(input.trace?.session_id) ||\n  `session_${channel}_${userId}`;\n\nconst rootEventId =\n  clean(input.trace?.event_id) ||\n  makeId('evt_root');\n\nconst correlationId =\n  clean(input.correlation?.correlation_id) ||\n  conversationId ||\n  sessionId ||\n  rootEventId;\n\nconst traceId =\n  clean(input.correlation?.trace_id) ||\n  sessionId ||\n  correlationId;\n\nreturn [\n  {\n    json: {\n      ...input,\n\n      trace: {\n        event_id: rootEventId,\n        conversation_id: conversationId,\n        session_id: sessionId,\n        parent_event_id: clean(input.trace?.parent_event_id)\n      },\n\n      context: {\n        business_id: clean(input.context?.business_id || input.source?.business_id || 'business_demo'),\n        environment: clean(input.context?.environment || input.source?.environment || 'demo'),\n        channel,\n        user_id: userId, // Ya bajará perfecto\n        // 👇 Corrección 2: Aseguramos que también pase tu nombre\n        display_name: clean(input.context?.display_name || input.user?.display_name || rawInput.display_name)\n      },\n\n      correlation: {\n        message_id: messageId,\n        transaction_id: clean(input.correlation?.transaction_id),\n        handoff_id: clean(input.correlation?.handoff_id),\n        correlation_id: correlationId,\n        trace_id: traceId\n      },\n\n      input: {\n        ...rawInput,\n        message_id: messageId,\n        type: clean(rawInput.type || 'text'),\n        text: clean(rawInput.text || rawInput.normalized_text),\n        timestamp: clean(rawInput.timestamp || new Date().toISOString()),\n        processing_status: clean(rawInput.processing_status || 'ready')\n      }\n    }\n  }\n];"
