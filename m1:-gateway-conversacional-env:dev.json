    {
      "parameters": {
        "jsCode": "const input = $json;\n\n const base = $('Validacion de mensaje').item.json;\n const message = base.message || {};\n const contact = base.contact || {};\n const metadata = base.metadata || {};\n\n const environment = base.environment || 'demo';\n const businessId = base.business_id || 'business_demo';\n\n const externalMessageId = message.id || null;\n const timestampUnix = message.timestamp ? Number(message.timestamp) : null;\n const timestampIso = timestampUnix\n   ? new Date(timestampUnix * 1000).toISOString()\n   : new Date().toISOString();\n\n const phoneNumberId = metadata.phone_number_id || null;\n const userPhone = contact.wa_id || message.from || null;\n const channelUserId = contact.user_id || message.from_user_id || null;\n\n const messageType = input.message_type || input.type || message.type || 'unsupported';\n const caption = input.caption || message?.image?.caption || message?.video?.caption || null;\n const contentText = (input.content_text || input.texto || input.text || '').trim();\n\n const normalizedParts = [];\n if (contentText) normalizedParts.push(contentText);\n if (caption && !contentText.includes(caption)) normalizedParts.push(`caption: ${caption}`);\n const normalizedText = normalizedParts.join('\\n').trim();\n\n const mediaType = input.media_type || (\n   ['audio', 'image', 'video'].includes(messageType) ? messageType : null\n );\n\n const mediaId = input.media_id || message?.audio?.id || message?.image?.id || message?.video?.id || null;\n\n const cleanId = (externalMessageId || String(Date.now())).replace(/[^a-zA-Z0-9]/g, '').slice(0, 48);\n const eventId = `evt_${cleanId}`;\n const rawRef = `raw_${cleanId}`;\n\n const sessionId = `wa_${environment}_${phoneNumberId || 'unknown'}_${userPhone || 'unknown'}`;\n const conversationId = `conv_wa_${phoneNumberId || 'unknown'}_${userPhone || 'unknown'}`;\n\n return [\n   {\n \tjson: {\n   \tschema_version: 'dalia.m1_to_m2.v1',\n   \ttrace: {\n     \tevent_id: eventId,\n     \traw_ref: rawRef,\n     \treceived_at: timestampIso\n   \t},\n   \tsource: {\n     \tenvironment,\n     \tbusiness_id: businessId,\n     \tchannel: 'whatsapp',\n     \tprovider: 'whatsapp_cloud_api',\n     \tbusiness_phone_id: phoneNumberId\n   \t},\n   \tuser: {\n     \tuser_id: userPhone,\n     \tchannel_user_id: channelUserId,\n     \tdisplay_name: contact?.profile?.name || null,\n     \tphone: userPhone\n   \t},\n   \tsession: {\n     \tsession_id: sessionId,\n     \tconversation_id: conversationId\n   \t},\n   \tmessage: {\n     \tmessage_id: externalMessageId,\n         external_message_id: externalMessageId,\n     \tcontext_id: base.context_id || null,\n     \ttype: messageType,\n     \ttext: normalizedText,\n     \tnormalized_text: normalizedText,\n     \ttimestamp: timestampIso\n   \t},\n   \tinput_context: {\n     \thas_media: Boolean(mediaType),\n     \tmedia_type: mediaType,\n     \tmedia_id: mediaId,\n     \tcaption,\n     \tprocessing_status: input.processing_status || (normalizedText ? 'ready' : 'error'),\n     \ttechnical_issue: input.technical_issue || (normalizedText ? null : 'empty_content')\n   \t}\n \t}\n   }\n ];\n"
      },
