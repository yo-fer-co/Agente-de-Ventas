      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// TEST.02: arma una respuesta de eco para probar el envío (solo mensajes de texto)\nconst m = $('Mensaje entrante').item.json;\nreturn { json: { port: 'channel', operation: 'send', input: { to: m.from?.channel_user_id, message: { type: 'text', text: 'DALIA · prueba de canal: recibí \"' + String(m.text || '').slice(0, 200) + '\"' }, reply_to_message_id: m.channel_message_id }, envelope: { trace_id: 'test-' + m.channel_message_id, correlation_id: 'test-' + (m.channel_thread_id || '') } } };"
      }
