    {
      "parameters": {
        "jsCode": "const chat_id = $json.session_id;\nconst body = $json.text_body;\nconst reply_markup = $json.reply_markup ? (typeof $json.reply_markup === 'string' ? JSON.parse($json.reply_markup) : $json.reply_markup) : null;\nconst media_url = $json.caption;\nconst mime_type = $json.mime_type;\n\nconst payload = {\n  chat_id: chat_id.toString(),\n  parse_mode: 'HTML'\n};\n\nswitch(mime_type){\n  case \"text\": payload.text = body;\n    break;\n  case \"image\": payload.photo = media_url;\n    break;\n}\n\nif (reply_markup) {\n  payload.reply_markup = reply_markup;\n}\n\nreturn { payload };"
      },
