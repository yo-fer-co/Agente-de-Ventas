    {
      "parameters": {
        "jsCode": "const reply = $input.first().json;\n\n// user_id viene como \"tg:1103727157\", recuperamos el número\nconst chatId = reply.chat_id || reply.user_id.replace('tg:', '');\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    text: reply.reply_text || 'Lo siento, no tengo respuesta en este momento.'\n  }\n}];\n"
      },
