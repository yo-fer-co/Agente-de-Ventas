    {
      "parameters": {
        "jsCode": "// Obtenemos el payload completo que viene del Telegram Trigger\nconst update = $input.first().json;\n\nconst msg = update.message || {};\nconst from = msg.from || {};\nconst chat = msg.chat || {};\n\nconst userId = from.id;\nconst chatId = chat.id;\nconst text = msg.text || '';\nconst language = from.language_code || 'es';\n\n// Timestamps: 'date' es epoch en segundos\nconst dateEpoch = msg.date ? msg.date * 1000 : Date.now();\nconst isoDate = new Date(dateEpoch).toISOString();\n\n// Para el MVP, client_hint fijo\nconst clientHint = 'yoeco_telegram_poc';\n\n// event_id y conversation_id sencillos\nconst eventId = `tg_${dateEpoch}_${msg.message_id || 'm0'}`;\nconst conversationId = `tg_chat_${chatId}`;\n\n// Construimos el ConversationEvent\nconst conversationEvent = {\n  event_id: eventId,\n  channel: 'telegram',\n  client_hint: clientHint,\n  client_id_hint: null,        // se llenará en la capa Agentic\n  user_id: `tg:${userId}`,\n  chat_id: chatId,\n  conversation_id: conversationId,\n  direction: 'inbound',\n  text,\n  attachments: [],             // para el MVP solo manejamos texto\n  locale_hint: language,\n  timestamp: isoDate,\n  raw: update\n};\n\nreturn [{ json: conversationEvent }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "09280929-c2a3-4715-8f23-c76110fdc764",
      "name": "FN_Normalize_Telegram_To_ConversationEvent"
    },
    {
      "parameters": {
        "jsCode": "const event = $input.first().json;\n\n// Para el MVP usamos el chat como session_id\nevent.session_id = event.conversation_id;\n\nreturn [{ json: event }];\n"
      },
      "type": "n8n-nodes-base.code",
