      "parameters": {
        "jsCode": "return {\n  json: {\n    // $execution.id es una variable global de n8n que trae el ID único de esta corrida\n    execution_id: $execution.id, \n    // Mantenemos tu variable de entorno que vi en tu JSON anterior\n    environment: $('When Executed by Another Workflow').item.json.environment || 'dev' \n  }\n};"
      },
