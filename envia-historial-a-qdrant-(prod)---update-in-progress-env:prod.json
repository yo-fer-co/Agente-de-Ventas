        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "qdrantApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  points: [\n    {\n      id: $json.id ?? undefined,\n      vector: $json.vector,\n      payload: {\n          user_id: Number($json.user_id    ?? $json.user_id   ?? 0),\n          timestamp: $json.timestap,\n          text: $json.text\n      }\n    }\n  ]\n}\n}}",
        "options": {}
