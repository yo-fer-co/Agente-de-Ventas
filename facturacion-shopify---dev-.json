      {
        "parameters": {
          "jsCode": "// Node: Mapear Items\nconst body = $(\"Data_Clensing\").first().json.body;\nconst lineItems = body.line_items || [];\nconst items = lineItems.map(li => {\n  const quantity = Number(li.quantity) || 1;\n  // tax_lines es un array: sumamos el IVA total de esta linea\n  const lineTax = (li.tax_lines || []).reduce(\n    (sum, t) => sum + parseFloat(t?.price_set?.shop_money?.amount ?? t?.price ?? 0), 0);\n  // Precio unitario sin IVA (Shopify envia precios con IVA incluido)\n  const unitPrice = parseFloat(li.price || 0) - lineTax / quantity;\n  return {\n    code: li.sku || String(li.variant_id || li.product_id || \"\"),\n    description: li.name || li.title || \"\",\n    quantity: li.quantity,\n    price: Math.round(unitPrice * 100) / 100,\n    discount: parseFloat(li.total_discount || 0),\n    taxes: [{ id: 7192 }],\n  };\n});\n\nreturn { json: { items } };"
        },
        "id": "9e30f6fe-d112-4905-9b3e-16c1ccd9a0fd",
        "name": "ArrayItems",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -592,
          240
        ]
      },
      {
        "parameters": {
          "jsCode": "// Node: Mapear Documento (sin items)\nconst body = $('Data_Clensing').first().json.body;\n\nconst billing = body.billing_address || {};\nconst customer = body.customer || {};\nconst contactEmail = body.contact_email || body.email || \"\";\nconst phoneRaw = billing.phone || customer.phone || \"\";\nconst phoneDigits = phoneRaw.replace(/\\D/g, \"\");\n\n// Separar indicativo (asumiendo Colombia = 57) si el número ya lo incluye\nlet indicative = \"57\";\nlet phoneNumber = phoneDigits;\nif (phoneDigits.startsWith(\"57\") && phoneDigits.length > 10) {\n  phoneNumber = phoneDigits.slice(2);\n}\n\n// Código postal puede venir null desde Shopify\nconst zip = String(billing.zip || \"1111111\").replace(/\\D/g, \"\");\nconst stateCode = zip.length >= 2 ? zip.slice(0, 2) : \"11\";\nconst cityCode = zip.length >= 2 ? zip.slice(0, 2) + \"001\" : \"11001\";\n\nconst firstName = billing.first_name || customer.first_name || \"\";\nconst lastName = billing.last_name || customer.last_name || \"\";\n\nconst result = {\n  resultado:{\n  document: {\n    id: 13370\n  },\n  date: (body.processed_at || body.created_at || \"\").slice(0, 10),\n  customer: {\n    person_type: \"Person\",\n    id_type: \"13\",\n    identification: billing.company,\n    branch_office: 0,\n    name: [firstName, lastName].filter(Boolean),\n    address: {\n      address: [billing.address1, billing.address2].filter(Boolean).join(\" \"),\n      city: {\n        country_code: billing.country_code || \"COL\",\n        country_name: billing.country || \"Colombia\",\n        state_code: stateCode,\n        state_name: \"Bogotá, D.C.\",\n        city_code: cityCode,\n        city_name: billing.city || \"\"\n      },\n      postal_code: zip\n    },\n    phones: [\n      {\n        indicative: indicative,\n        number: phoneNumber,\n        extension: \"\"\n      }\n    ],\n    contacts: [\n      {\n        first_name: firstName,\n        last_name: lastName,\n        email: contactEmail,\n        phone: {\n          indicative: indicative,\n          number: phoneNumber,\n          extension: \"\"\n        }\n      }\n    ]\n  },\n  seller: 798,\n  stamp: {\n    send: false\n  },\n  mail: {\n    send: true\n  },\n  items:$input.first().json.items,\n  payments: [\n    {\n      id: 13680,\n      value: parseFloat(body.total_price   || body.current_total_price || 0),\n      due_date: (body.processed_at || body.created_at || \"\").slice(0, 10)\n    }\n  ]\n},\n};\n\nreturn { json: result };"
        },
