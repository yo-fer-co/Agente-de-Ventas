      "parameters": {
        "jsCode": "const chat_id = $json.chat_id;\nconst body = $json.body;\nconst reply_markup = $json.reply_markup ? (typeof $json.reply_markup === 'string' ? JSON.parse($json.reply_markup) : $json.reply_markup) : null;\n\nconst payload = {\n  chat_id: chat_id.toString(),\n  text: body,\n  parse_mode: 'HTML'\n};\n\nif (reply_markup) {\n  payload.reply_markup = reply_markup;\n}\n\nreturn { payload };"
      },
