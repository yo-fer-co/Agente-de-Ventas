    {
      "parameters": {
        "jsCode": "const executionData = $input.first().json;\n\nlet prompt_tokens = 0;\nlet completion_tokens = 0;\nlet ai_response = \"No se encontró la respuesta\";\n\n// 1. Cazamos los tokens recorriendo todo el historial\nJSON.stringify(executionData, (key, value) => {\n  if (key === 'tokenUsage' || key === 'tokenUsageEstimate') {\n    prompt_tokens += value.promptTokens || 0;\n    completion_tokens += value.completionTokens || 0;\n  }\n  return value;\n});\n\n// 2. Cazamos la respuesta del Agente\ntry {\n  // n8n guarda los resultados de todos los nodos en esta ruta:\n  const runData = executionData.data.resultData.runData;\n  \n  // Buscamos tu nodo exactamente por su nombre\n  if (runData && runData[\"Agente Principal\"]) {\n    // Sacamos el texto crudo que devolvió el nodo\n    const rawOutput = runData[\"Agente Principal\"][0].data.main[0][0].json.output;\n    \n    // Como tu agente devuelve un JSON (con replyText, sendImage, etc.), lo parseamos\n    try {\n      const parsedData = JSON.parse(rawOutput);\n      // Agarramos solo el mensaje para el cliente\n      ai_response = parsedData.replyText || rawOutput; \n    } catch (e) {\n      // Si por alguna razón el agente no devolvió un JSON perfecto, guardamos el texto tal cual\n      ai_response = rawOutput;\n    }\n  }\n} catch (error) {\n  ai_response = \"Error buscando la respuesta: \" + error.message;\n}\n\n// 3. Devolvemos todo listo para tu base de datos\nreturn {\n  json: {\n    prompt_tokens: prompt_tokens,\n    completion_tokens: completion_tokens,\n    total_tokens: prompt_tokens + completion_tokens,\n    ai_response: ai_response,\n    model_name: \"gpt-5.1\" \n  }\n};"
      },
